# Ghostlink optional overrides: every key is optional with official builds,
# except as noted below. config.env is optional. Remove unused placeholder lines;
# present values override compiled defaults, even when empty or invalid.
# Public API key/client ID/broker defaults are pending owner provisioning in this
# checkout, so required public values must still be supplied until then.
# For overrides, copy with owner-only permissions and fill values locally:
#
#   mkdir -p ~/.config/ghostlink
#   install -m 600 config.example.env ~/.config/ghostlink/config.env
#
# Precedence per key: process environment > this file > compiled defaults.
# Client secrets NEVER have a compiled default and must never be committed.

# OAuth configuration placeholders (secret > broker URL > public mode).
BUNGIE_API_KEY=YOUR_BUNGIE_API_KEY
BUNGIE_PUBLIC_CLIENT_ID=YOUR_PUBLIC_OAUTH_CLIENT_ID
# Optional confidential mode: switch the Bungie app to Confidential first.
# Keep the secret only in this 0600 per-user file, never in shell exports.
# When present, BUNGIE_PUBLIC_CLIENT_ID is also required for CLI/MCP reads.
# BUNGIE_CLIENT_SECRET=
# Optional broker mode: the trusted broker holds the secret, not Ghostlink.
# Used only without BUNGIE_CLIENT_SECRET; absent any broker URL, mode is public.
# An env/file URL overrides the official compiled broker URL when provisioned.
# HTTPS base URL, no credentials/query/fragment (max 2048 bytes); /token is appended.
# BUNGIE_PUBLIC_CLIENT_ID is required for broker-mode CLI/MCP reads too.
# GHOSTLINK_TOKEN_BROKER_URL=https://YOUR_BROKER.workers.dev
BUNGIE_CALLBACK_URI=ghostlink://oauth/callback
BUNGIE_REGISTERED_CALLBACK_URI=ghostlink://oauth/callback

# Shared read runtime configuration for the CLI and MCP composition roots. The
# BUNGIE_API_KEY above is reused. Exceptions: database path remains required
# until PR-005; definition version remains required pending PR-006 (persisted
# provenance/revision identity, not an arbitrary label). TTL defaults to 900;
# overrides must be positive seconds (maximum 2592000).
DESTINY_DATABASE_PATH=YOUR_DESTINY_DATABASE_PATH
DESTINY_DEFINITION_VERSION=YOUR_MANIFEST_DEFINITION_VERSION
DESTINY_FRESHNESS_TTL_SECONDS=900
